      "schema_enforced": false,
      "unit_normalization": false,
      "numeric_extraction": "n/a",
      "selection_logic": "keyword pool then signal score; candidate evidence uses edge counts",
      "notes": []
    },
    {
      "path": "fabric/services/retrieval_service.py",
      "entrypoint": "RetrievalBackend",
      "kgs": [
        "workspaces/<topic>/vector_store (sections)",
        "workspaces/<topic>/graph.sqlite"
      ],
      "retrieval": "vector search (FAISS/cosine) + BM25 fallback; graph_neighbors from sqlite",
      "methods_prioritized": "no section_type filter; uses schema alias expansion",
      "schema_enforced": false,
      "unit_normalization": false,
      "numeric_extraction": "n/a",
      "selection_logic": "top_k ranking; optional iterative expansion",
      "notes": []
    },
    {
      "path": "fabric/agents/qa_graph.py",
