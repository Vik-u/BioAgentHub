      "kgs": [
        "workspaces/<topic>/methodology_vector_store",
        "workspaces/<topic>/methodology_edge_store"
      ],
      "retrieval": "vector search over sections and edges (FAISS or cosine)",
      "methods_prioritized": "section_search supports section_type filter; edge_search does not",
      "schema_enforced": false,
      "unit_normalization": false,
      "numeric_extraction": "n/a",
      "selection_logic": "top_k vector similarity",
      "notes": [
        "filter_edges_by_section exists but is not used in protocol_agent_v2.py"
      ]
    },
    {
      "path": "fabric/agents/rag_agent.py",
      "entrypoint": "collect_kg_edge_evidence / collect_candidate_evidence",
